{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fields, ruleset v0",
  "description": "Read by GodGame.Sim.Rules.RulesetLoader. Numbers are integers; unknown keys are rejected. At most 16 fields.",
  "type": "object",
  "required": ["version", "tileCells", "sleepAfterSteps", "fields", "interactions", "water", "ground"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "version": { "const": 0 },
    "status": { "enum": ["placeholder", "settled"] },
    "tileCells": { "type": "integer", "minimum": 4, "maximum": 64, "description": "Cells per side of an activity tile" },
    "sleepAfterSteps": { "type": "integer", "minimum": 1, "maximum": 100, "description": "Quiet field steps before a tile sleeps" },
    "fields": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "unit", "min", "max", "initial"],
        "additionalProperties": false,
        "properties": {
          "$comment": { "type": "string" },
          "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
          "unit": { "enum": ["mm", "um", "umPerS", "scale", "centidegrees", "cmPerS", "code"], "description": "mm within ±10 km; um and umPerS within ±10^9; scale 0 to 65535; centidegrees and cmPerS within ±10000; code 0 to 16777215 (packed bytes, documented per field)" },
          "min": { "type": "integer" },
          "max": { "type": "integer" },
          "initial": { "type": "integer" }
        }
      }
    },
    "ground": {
      "type": "object",
      "description": "Wetness, mud and soils (spec S1, sections 5 and 6)",
      "required": ["unitsPerUm", "infiltrationUmPerS", "dryingPerS", "mudBaseStart", "mudCapStart", "mudCapNum", "mudCapDen", "churnAtFullWetness", "churnWeight", "soils"],
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "unitsPerUm": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "infiltrationUmPerS": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "dryingPerS": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "mudBaseStart": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "mudCapStart": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "mudCapNum": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "mudCapDen": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "churnAtFullWetness": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "churnWeight": {
          "type": "object",
          "required": ["foot", "horse", "wheeled", "water"],
          "additionalProperties": false,
          "properties": {
            "foot": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "horse": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "wheeled": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "water": { "type": "integer", "minimum": 0, "maximum": 10000 }
          }
        },
        "soils": {
          "type": "array",
          "minItems": 1,
          "maxItems": 255,
          "description": "The first soil is the default for every cell no map soil area covers",
          "items": {
            "type": "object",
            "required": ["id", "churnPermille", "capPermille"],
            "additionalProperties": false,
            "properties": {
              "$comment": { "type": "string" },
              "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
              "churnPermille": { "type": "integer", "minimum": 0, "maximum": 10000 },
              "capPermille": { "type": "integer", "minimum": 0, "maximum": 1000 }
            }
          }
        }
      }
    },
    "water": {
      "type": "object",
      "required": ["substepsPerFieldStep", "pipeGainPermille", "bedFrictionPpm", "fluxDeadbandUmPerS", "headDeadbandUm", "dryDepthUm"],
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "substepsPerFieldStep": { "type": "integer", "minimum": 1, "maximum": 16 },
        "pipeGainPermille": { "type": "integer", "minimum": 1, "maximum": 10000, "description": "g * dt / cell, in permille" },
        "bedFrictionPpm": { "type": "integer", "minimum": 0, "maximum": 1000000, "description": "Bed friction coefficient c_f in millionths" },
        "fluxDeadbandUmPerS": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "headDeadbandUm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "dryDepthUm": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "rate"],
        "additionalProperties": false,
        "properties": {
          "$comment": { "type": "string" },
          "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$", "description": "The rule's name; the model that applies it documents its scale" },
          "source": { "type": "string", "description": "A field id listed above" },
          "target": { "type": "string", "description": "A field id listed above" },
          "rate": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
          "threshold": { "type": "integer" }
        }
      }
    }
  }
}
