{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Movement classes, ruleset v0",
  "description": "Read by GodGame.Sim.Rules.RulesetLoader. Exactly one entry per class. A cell costs (baseCost + slopeCost * slopePermille / 1000) * 1000 / speedPermille; steeper than maxSlopePermille, too deep or sweeping water is impassable. Costs are relative (100 = a flat dry cell).",
  "type": "object",
  "required": [
    "version",
    "fieldCostRefreshTicks",
    "classes"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "version": {
      "const": 0
    },
    "status": {
      "enum": [
        "placeholder",
        "settled"
      ]
    },
    "classes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "baseCost",
          "slopeCost",
          "maxSlopePermille",
          "water",
          "mudSpeed"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "foot",
              "horse",
              "wheeled",
              "water"
            ]
          },
          "baseCost": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "slopeCost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Extra cost per 1000 permille of slope"
          },
          "maxSlopePermille": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000,
            "description": "Rise over run x 1000; steeper is impassable"
          },
          "$comment": {
            "type": "string"
          },
          "water": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "speed",
              "maxEnterDepthMm",
              "sweptDepthMm",
              "sweptDepthSpeed",
              "sweptMinDepthMm"
            ],
            "properties": {
              "speed": {
                "$ref": "#/$defs/curve",
                "description": "Wading speed by depth in mm"
              },
              "maxEnterDepthMm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000,
                "description": "Deeper water is closed to the class's own steering"
              },
              "sweptDepthMm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000,
                "description": "Swept away at this depth whatever the current"
              },
              "sweptDepthSpeed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000,
                "description": "Depth x flow speed (mm x mm/s / 1000) that sweeps the class"
              },
              "sweptMinDepthMm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000,
                "description": "Shallower water never sweeps"
              }
            }
          },
          "mudSpeed": {
            "$ref": "#/$defs/curve",
            "description": "Speed by mud (0-65535)"
          }
        }
      }
    },
    "fieldCostRefreshTicks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "description": "Ticks between refreshes of field-driven costs (20 = 1 Hz)"
    }
  },
  "$defs": {
    "curve": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        ]
      },
      "description": "[[x, speedPermille], ...] with x rising; linear between points, flat beyond"
    }
  }
}
