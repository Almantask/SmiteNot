{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unit types, ruleset v0",
  "description": "Read by GodGame.Sim.Rules.RulesetLoader. Numbers are integers; unknown keys are rejected.",
  "type": "object",
  "required": [
    "version",
    "unitTypes"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "version": {
      "const": 0
    },
    "status": {
      "enum": [
        "placeholder",
        "settled"
      ],
      "description": "placeholder: numbers no spec has set yet"
    },
    "unitTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "movementClass",
          "health",
          "morale",
          "speedMmPerS",
          "radiusMm",
          "formation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}$",
            "description": "Stable id used by plans and replays"
          },
          "movementClass": {
            "enum": [
              "foot",
              "horse",
              "wheeled",
              "water"
            ]
          },
          "health": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "description": "Starting hit points (ruleset units)"
          },
          "morale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000,
            "description": "Starting morale (ruleset units)"
          },
          "speedMmPerS": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000,
            "description": "Marching speed on flat open ground, mm per second"
          },
          "radiusMm": {
            "type": "integer",
            "minimum": 100,
            "maximum": 2500,
            "description": "Body radius on the ground plane, mm"
          },
          "formation": {
            "type": "object",
            "required": ["files", "fileSpacingMm", "rankSpacingMm", "minSoldiers", "maxSoldiers"],
            "additionalProperties": false,
            "properties": {
              "files": { "type": "integer", "minimum": 1, "maximum": 1000, "description": "Soldiers side by side in a rank" },
              "fileSpacingMm": { "type": "integer", "minimum": 100, "maximum": 20000, "description": "Neighbours in a rank, centre to centre, mm" },
              "rankSpacingMm": { "type": "integer", "minimum": 100, "maximum": 20000, "description": "One rank to the next, centre to centre, mm" },
              "minSoldiers": { "type": "integer", "minimum": 1, "maximum": 10000, "description": "Smallest regiment a plan may field, officer included" },
              "maxSoldiers": { "type": "integer", "minimum": 1, "maximum": 10000, "description": "Largest regiment a plan may field" }
            }
          }
        }
      }
    }
  }
}
